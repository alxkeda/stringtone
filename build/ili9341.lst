 247:adafruit_tft/ili9341.cpp ****                 uint8_t data[] = { bgcolor >> 8, bgcolor & 0xFF };
 248:adafruit_tft/ili9341.cpp ****                 ILI9341_WriteData(data, sizeof(data));
