  21:adafruit_tft/ili9341.cpp **** static void ILI9341_WriteCommand(uint8_t cmd) {
  22:adafruit_tft/ili9341.cpp ****     gpio_dc.Write(false);
  23:adafruit_tft/ili9341.cpp ****     buffer[0] = cmd;
  24:adafruit_tft/ili9341.cpp ****     spi_handle.DmaTransmit(buffer, sizeof(cmd), NULL, NULL, NULL);
  25:adafruit_tft/ili9341.cpp **** }
