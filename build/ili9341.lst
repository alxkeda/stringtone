 235:adafruit_tft/ili9341.cpp **** static void ILI9341_WriteChar(uint16_t x, uint16_t y, char ch, Adafruit_TFT_FontDef font, uint16_t 
 236:adafruit_tft/ili9341.cpp ****     uint32_t i, b, j;
 237:adafruit_tft/ili9341.cpp **** 
