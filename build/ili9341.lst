  31:adafruit_tft/ili9341.cpp **** 
  32:adafruit_tft/ili9341.cpp ****     // Split buff data into chunks that fit into the fixed size DMA buffer
  33:adafruit_tft/ili9341.cpp ****     if (buff_size > buffer_size) {
  34:adafruit_tft/ili9341.cpp ****         while(buff_size > 0) {
  35:adafruit_tft/ili9341.cpp ****             uint16_t chunk_size = buff_size > buffer_size ? buffer_size : buff_size;
  36:adafruit_tft/ili9341.cpp ****             memcpy(buffer, buff, chunk_size);
  37:adafruit_tft/ili9341.cpp ****             spi_handle.DmaTransmit(buffer, chunk_size, NULL, NULL, NULL);
  38:adafruit_tft/ili9341.cpp ****             buff += chunk_size;
  39:adafruit_tft/ili9341.cpp ****             buff_size -= chunk_size;
  40:adafruit_tft/ili9341.cpp ****         }
  41:adafruit_tft/ili9341.cpp ****     } else {
  42:adafruit_tft/ili9341.cpp ****         memcpy(buffer, buff, buff_size);
  43:adafruit_tft/ili9341.cpp ****         spi_handle.DmaTransmit(buffer, buff_size, NULL, NULL, NULL);
  44:adafruit_tft/ili9341.cpp ****     }
  45:adafruit_tft/ili9341.cpp **** 
  46:adafruit_tft/ili9341.cpp **** }
