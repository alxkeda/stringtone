 225:adafruit_tft/ili9341.cpp **** static void ILI9341_WriteChar(uint16_t x, uint16_t y, char ch, Adafruit_TFT_FontDef font, uint16_t 
 226:adafruit_tft/ili9341.cpp ****     uint32_t i, b, j;
 227:adafruit_tft/ili9341.cpp **** 
 228:adafruit_tft/ili9341.cpp ****     ILI9341_SetAddressWindow(x, y, x+font.width-1, y+font.height-1);
