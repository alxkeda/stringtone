   7:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h **** namespace daisy
   8:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h **** {
   9:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h **** /** @brief DAC handle for Built-in DAC Peripheral 
  10:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h ****  *  @ingroup per_analog
  11:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h ****  ** 
  12:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h ****  ** For now only Normal Mode is supported,
  13:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h ****  ** Sample and hold mode provides reduced power consumption, but requires a bit more setup.
  14:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h ****  **
  15:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h ****  ** For now connecting the DAC through other internal peripherals is also not supported.
  16:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h ****  **
  17:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h ****  ** Since the DAC channels have dedicated pins we don't need to pass in a pin config like with
  18:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h ****  ** other modules. However, it is still important to not try to use the DAC pins for anything else.
  19:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h ****  ** DAC Channel 1 is on PA4, and DAC Channel 2 is on PA5
  20:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h ****  ***/
  21:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h **** class DacHandle
  22:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h **** {
  23:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h ****   public:
  24:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h ****     /** Return Values for the DacHandle class */
  25:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h ****     enum class Result
  26:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h ****     {
  27:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h ****         OK,
  28:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h ****         ERR,
  29:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h ****     };
  30:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h **** 
  31:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h ****     /** Selects which channel(s) will be configured for use. */
  32:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h ****     enum class Channel
  33:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h ****     {
  34:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h ****         ONE,
  35:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h ****         TWO,
  36:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h ****         BOTH,
  37:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h ****     };
  38:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h **** 
  39:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h ****     /** Sets the Mode for the DAC channels.
  40:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h ****      **
  41:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h ****      ** Polling mode uses the blocking mode to transmit a single value at a time.
  42:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h ****      **
  43:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h ****      ** DMA mode uses a buffer, and periodically transmits it triggering a 
  44:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h ****      ** callback to fill the buffer when it is ready for more samples.
  45:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h ****      ***/
  46:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h ****     enum class Mode
  47:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h ****     {
  48:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h ****         POLLING,
  49:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h ****         DMA,
  50:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h ****     };
  51:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h **** 
  52:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h ****     /** Sets the number of bits per sample transmitted out of the DAC.
ARM GAS  /var/folders/0b/4qn_4lxx65nfvy4wf60ckd5w0000gn/T//ccwEFg80.s 			page 24


  53:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h ****      ** The output range will be: 0V - VDDA
  54:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h ****      ** The resolution will be roughly: bitdepth / (VDDA - 0V) 
  55:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h ****      ***/
  56:../../DaisySeed/DaisyExamples/libDaisy/src/per/dac.h ****     enum class BitDepth
