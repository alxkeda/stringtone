  83:../../DaisySeed/DaisyExamples/libDaisy/src/daisy_core.h **** 
  84:../../DaisySeed/DaisyExamples/libDaisy/src/daisy_core.h **** /**
  85:../../DaisySeed/DaisyExamples/libDaisy/src/daisy_core.h ****     Converts float to unsigned 8-bit
