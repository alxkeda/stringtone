   1:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h **** #pragma once
   2:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h **** #ifndef DSY_SAI_H
   3:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h **** #define DSY_SAI_H
   4:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h **** 
   5:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h **** #include "daisy_core.h"
   6:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h **** 
   7:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h **** namespace daisy
   8:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h **** {
   9:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h **** /** 
  10:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  * Support for I2S Audio Protocol with different bit-depth, samplerate options
  11:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  * Allows for master or slave, as well as freedom of selecting direction, 
  12:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  * and other behavior for each peripheral, and block.
  13:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  * 
  14:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  * DMA Transfer commands must use buffers located within non-cached memory or use cache maintenance
  15:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  * To declare an unitialized global element in the DMA memory section:
  16:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  *    int32_t DSY_DMA_BUFFER_SECTOR my_buffer[96];
  17:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  *
  18:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  * Callback functions will be called once per half of the buffer. In the above example, 
  19:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  * the callback function would be called once for every 48 samples.
  20:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  * 
  21:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  * Use SAI Handle like this:
  22:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  * 
  23:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  *  SaiHandle::Config sai_config;
  24:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  *  sai_config.periph          = SaiHandle::Config::Peripheral::SAI_1;
  25:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  *  sai_config.sr              = SaiHandle::Config::SampleRate::SAI_48KHZ;
  26:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  *  sai_config.bit_depth       = SaiHandle::Config::BitDepth::SAI_24BIT;
  27:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  *  sai_config.a_sync          = SaiHandle::Config::Sync::MASTER;
  28:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  *  sai_config.b_sync          = SaiHandle::Config::Sync::SLAVE;
  29:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  *  sai_config.a_dir           = SaiHandle::Config::Direction::RECEIVE;
  30:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  *  sai_config.b_dir           = SaiHandle::Config::Direction::TRANSMIT;
  31:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  *  sai_config.pin_config.fs   = {DSY_GPIOE, 4};
  32:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  *  sai_config.pin_config.mclk = {DSY_GPIOE, 2};
  33:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  *  sai_config.pin_config.sck  = {DSY_GPIOE, 5};
  34:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  *  sai_config.pin_config.sa   = {DSY_GPIOE, 6};
  35:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  *  sai_config.pin_config.sb   = {DSY_GPIOE, 3};
  36:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  *  // Then Initialize
  37:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  *  SaiHandle sai;
  38:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  *  sai.Init(sai_config);
  39:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  *  // Now you can use it:
  40:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  *  sai.StartDma(. . .);
  41:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  */
  42:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h **** class SaiHandle
  43:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h **** {
  44:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****   public:
  45:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****     /** Contains settings for initialising an SAI Interface */
  46:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****     struct Config
  47:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****     {
  48:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****         /** Specifies the internal peripheral to use (mapped to different hardware pins) */
  49:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****         enum class Peripheral
  50:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****         {
  51:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****             SAI_1,
  52:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****             SAI_2,
  53:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****         };
  54:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h **** 
  55:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****         /** Rate at which samples will be streaming to/from the device. */
ARM GAS  /var/folders/0b/4qn_4lxx65nfvy4wf60ckd5w0000gn/T//ccwEFg80.s 			page 26


  56:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****         enum class SampleRate
  57:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****         {
