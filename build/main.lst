  18:../../DaisySeed/DaisyExamples/libDaisy/src/per/i2c.h ****  *      // initialise the peripheral
  19:../../DaisySeed/DaisyExamples/libDaisy/src/per/i2c.h ****  *      I2CHandle i2c;
