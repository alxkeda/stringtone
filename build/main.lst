   9:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h **** /** 
  10:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  * Support for I2S Audio Protocol with different bit-depth, samplerate options
  11:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  * Allows for master or slave, as well as freedom of selecting direction, 
  12:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  * and other behavior for each peripheral, and block.
  13:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  * 
  14:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  * DMA Transfer commands must use buffers located within non-cached memory or use cache maintenance
  15:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  * To declare an unitialized global element in the DMA memory section:
  16:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  *    int32_t DSY_DMA_BUFFER_SECTOR my_buffer[96];
  17:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  *
  18:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  * Callback functions will be called once per half of the buffer. In the above example, 
  19:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  * the callback function would be called once for every 48 samples.
  20:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  * 
  21:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  * Use SAI Handle like this:
  22:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  * 
  23:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  *  SaiHandle::Config sai_config;
  24:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  *  sai_config.periph          = SaiHandle::Config::Peripheral::SAI_1;
  25:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  *  sai_config.sr              = SaiHandle::Config::SampleRate::SAI_48KHZ;
  26:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  *  sai_config.bit_depth       = SaiHandle::Config::BitDepth::SAI_24BIT;
ARM GAS  /var/folders/0b/4qn_4lxx65nfvy4wf60ckd5w0000gn/T//ccV94jnw.s 			page 28


  27:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  *  sai_config.a_sync          = SaiHandle::Config::Sync::MASTER;
  28:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  *  sai_config.b_sync          = SaiHandle::Config::Sync::SLAVE;
  29:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  *  sai_config.a_dir           = SaiHandle::Config::Direction::RECEIVE;
  30:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  *  sai_config.b_dir           = SaiHandle::Config::Direction::TRANSMIT;
  31:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  *  sai_config.pin_config.fs   = {DSY_GPIOE, 4};
  32:../../DaisySeed/DaisyExamples/libDaisy/src/per/sai.h ****  *  sai_config.pin_config.mclk = {DSY_GPIOE, 2};
