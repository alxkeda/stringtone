  74:../../DaisySeed/DaisyExamples/libDaisy/src/daisy_core.h **** /** 
  75:../../DaisySeed/DaisyExamples/libDaisy/src/daisy_core.h ****     Converts unsigned 8-bit to float
  76:../../DaisySeed/DaisyExamples/libDaisy/src/daisy_core.h ****     \param x Number to be scaled.
